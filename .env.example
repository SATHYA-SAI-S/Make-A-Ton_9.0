# SubscriptIQ Configuration Template
# For local development with Mailpit: Web UI http://127.0.0.1:8025 | SMTP 127.0.0.1:1025

# Application
PROJECT_NAME=SubscriptIQ
APP_NAME=SubscriptIQ
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
SECRET_KEY=dev-secret-key-subscriptiq-change-in-production-2026-secure
JWT_SECRET_KEY=dev-secret-key-subscriptiq-change-in-production-2026-secure
INTERNAL_SERVICE_KEY=subscriptiq-internal-dev-key-2026

# Database
DATABASE_URL=sqlite:///./subscriptiq.db
TEST_DATABASE_URL=sqlite:///./test.db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Email & SMTP (Mailpit in local dev)
EMAIL_PROVIDER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=noreply@subscriptiq.local
SMTP_FROM_NAME=SubscriptIQ
EMAILS_FROM_EMAIL=noreply@subscriptiq.local
EMAILS_FROM_NAME=SubscriptIQ
FRONTEND_URL=http://127.0.0.1:5173

# Auth & OTP
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Billing & Taxes
COMPANY_STATE_CODE=KA
COMPANY_NAME=Brightloop Software Private Limited
COMPANY_GSTIN=29AABCU9603R1Z7
DEFAULT_CURRENCY=INR

# Payment Gateways (Test Mode)
RAZORPAY_KEY_ID=rzp_test_samplekey123
RAZORPAY_KEY_SECRET=sample_secret_key_456
RAZORPAY_WEBHOOK_SECRET=sample_webhook_secret_789
STRIPE_API_KEY=sk_test_samplekey123
STRIPE_WEBHOOK_SECRET=whsec_sample_secret

# SubscriptIQ Configuration Template
# For local development with Mailpit:
# Web UI: http://127.0.0.1:8025 | SMTP: 127.0.0.1:1025

PROJECT_NAME=SubscriptIQ
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1

DATABASE_URL=sqlite:///./subscriptiq.db

JWT_SECRET_KEY=dev-secret-key-subscriptiq-change-in-production-2026-secure
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

INTERNAL_SERVICE_KEY=subscriptiq-internal-dev-key-2026

# Local Mailpit Configuration (Default for development/demos)
EMAIL_PROVIDER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=noreply@subscriptiq.local
SMTP_FROM_NAME=SubscriptIQ
FRONTEND_URL=http://127.0.0.1:5173

# Production SMTP Examples:
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_TLS=true
# Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=587, SMTP_USE_TLS=true
# SendGrid: SMTP_HOST=smtp.sendgrid.net, SMTP_PORT=587, SMTP_USE_TLS=true

OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Application
PROJECT_NAME="SubscriptIQ"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database (Postgres for production/docker, sqlite for zero-dependency tests)
DATABASE_URL="sqlite:///./subscriptiq.db"
# DATABASE_URL="postgresql+psycopg2://subscriptiq:subscriptiq_dev_pass@localhost:5432/subscriptiq_db"

# JWT Authentication
JWT_SECRET_KEY="replace-this-in-production-with-a-secure-random-64-char-string"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Internal Service Security Key (for Person 2 & 3 inter-service endpoints)
INTERNAL_SERVICE_KEY="subscriptiq-internal-dev-key-2026"

# Admin Seeding
SEED_ADMIN_EMAIL="admin@subscriptiq.local"
SEED_ADMIN_PASSWORD="Admin@SecurePassword2026!"
